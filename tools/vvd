#!/usr/bin/env bash
# Drive the Vega Virtual Device: press remote keys, take screenshots.
#
# The Vega CLI has no way to inject a key press and no way to capture the
# screen, so verifying the TV app meant watching the window and pressing keys
# by hand — which is not verification, and is impossible to put in a test.
#
# The VVD is an Android-emulator-derived QEMU and it exposes the standard
# emulator console on an even port from 5554 up, authenticated by the token the
# emulator wrote to ~/.emulator_console_auth_token. That console has
# `event send` and `screenrecord screenshot`. Everything below is those two
# commands.
#
# The port is probed, not assumed. This said 5556 for most of the project and
# was right for the wrong reason: an unrelated Android emulator had been
# running for thirty-eight days and held 5554, so the VVD landed on the next
# slot. Stopping that emulator moved the VVD to 5554 and every command here
# would have failed with the silence of an unanswered socket, which is
# indistinguishable from the device having died — the exact failure this
# project already lost hours to.
#
# Key injection does not work, and fails silently: `event send EV_KEY:...`
# is accepted and answered OK, and nothing reaches the app. Vega OS is not
# Android, so the console's key path has nowhere to deliver to. `event mouse`
# does route, so `tap` is how this drives the UI — a Pressable answers a touch
# the same way it answers a select.
#
# Usage:
#   tools/vvd up [WxH]             # start and VERIFY; start alone exits 0 on failure
#   tools/vvd tap X Y              # 1920x1080 frame; this is the working one
#   tools/vvd key ENTER|UP|DOWN    # accepted by the console, does nothing
#   tools/vvd shot [path.png]
#   tools/vvd rec start [path.webm]   # true 1920x1080, bypasses the display
#   tools/vvd rec stop                # 180s max, no audio (no audio sink)
#   tools/vvd console "<raw console command>"
set -euo pipefail

TOKEN_FILE="${VVD_TOKEN_FILE:-$HOME/.emulator_console_auth_token}"
[ -r "$TOKEN_FILE" ] || { echo "no console token at $TOKEN_FILE" >&2; exit 1; }

find_port() {
  # Emulator consoles sit on even ports from 5554. Take the first that answers
  # the emulator greeting, so an unrelated Android emulator on an earlier slot
  # is skipped rather than talked to by mistake.
  #
  # The greeting is captured and then matched, rather than piped into
  # `grep -q`. Under `set -o pipefail` those are not the same thing: grep -q
  # exits at the first match, nc takes EPIPE, and the pipeline reports failure
  # even though the port answered perfectly. The first version of this probe
  # did exactly that and declared a healthy device absent.
  local p hello
  for p in 5554 5556 5558 5560 5562; do
    hello="$(printf 'quit\n' | nc -w 2 127.0.0.1 "$p" 2>/dev/null || true)"
    case "$hello" in
      *"Android Console"*) echo "$p"; return 0 ;;
    esac
  done
  return 1
}

# Resolved on demand, not at startup. `up` runs before any console exists —
# resolving eagerly made it fail on the exact condition it is there to fix.
PORT=""
need_port() {
  [ -n "$PORT" ] && return 0
  PORT="${VVD_CONSOLE_PORT:-$(find_port || true)}"
  [ -n "$PORT" ] || {
    echo "no emulator console answering on 5554-5562 — is the device up?" >&2
    echo "  tools/vvd up" >&2
    exit 1; }
}

console() {
  need_port
  # The token never reaches the command line, so it stays out of `ps` and out
  # of any shell history.
  { printf 'auth %s\n' "$(cat "$TOKEN_FILE")"; printf '%s\n' "$@"; \
    printf 'quit\n'; } | nc -w 5 127.0.0.1 "$PORT" 2>/dev/null
}

case "${1:-}" in
  up)
    # Start the device and verify it, because `vega virtual-device start`
    # cannot be trusted to say whether it worked: on a failed boot it prints
    # "Deadline reached (60s) but virtual device unresponsive." and **exits
    # 0**, leaving {"running":false}. Every `start && install && launch` chain
    # therefore proceeds against a device that is not there, and the failure
    # surfaces two commands later as "Device not found", which reads like you
    # forgot to start it. Boots are also flaky: the same command on the same
    # machine has taken 30s, 70s, and failed outright minutes apart.
    res="${2:-1920,1080}"
    tries="${VVD_TRIES:-4}"
    for attempt in $(seq 1 "$tries"); do
      echo "vvd up: attempt $attempt/$tries (${res})" >&2
      vega virtual-device start --display-res="$res" >/dev/null 2>&1 || true
      for _ in $(seq 1 12); do
        if vega device list 2>/dev/null | grep -q VirtualDevice; then
          echo "vvd up: device listed" >&2
          # Listed is not the same as reachable; the console is what every
          # other subcommand here needs.
          for _ in $(seq 1 12); do
            if find_port >/dev/null; then
              echo "vvd up: console on $(find_port)" >&2
              exit 0
            fi
            sleep 5
          done
          echo "vvd up: listed but no console — treating as failed" >&2
          break
        fi
        sleep 5
      done
      vega virtual-device stop >/dev/null 2>&1 || true
    done
    echo "vvd up: gave up after $tries attempts" >&2
    exit 1
    ;;
  tap)
    x="${2:?x}"; y="${3:?y}"
    console "event mouse $x $y 0 1" "event mouse $x $y 0 0" >/dev/null
    ;;
  key)
    # Press and release. Sending only the press leaves the key held down, and
    # the next press is then swallowed.
    code="KEY_${2:?which key}"
    console "event send EV_KEY:${code}:1" "event send EV_KEY:${code}:0" \
      >/dev/null
    ;;
  text)   console "event text ${2:?what text}" >/dev/null ;;
  rec)
    # Video straight off the device framebuffer, which is the only way to get
    # a true 1920x1080 capture here: this Mac's desktop maxes out at 1680x1050
    # logical, so the VVD's own window is shown shrunk and a screen recording
    # captures the shrunk copy. This path never touches the display.
    #
    # No audio — the VVD has no audio sink at all (FRICTION 7), so narration
    # is laid under in the edit either way.
    case "${2:-}" in
      start)
        dest="${3:-$PWD/out/vvd-$(date +%H%M%S).webm}"
        mkdir -p "$(dirname "$dest")"
        # 180s is the console's own maximum, not a choice.
        console "screenrecord start --fps 30 --bit-rate 8M $dest" >/dev/null
        echo "$dest"
        ;;
      stop)
        console "screenrecord stop" >/dev/null
        ;;
      *) echo "usage: tools/vvd rec start [path.webm] | tools/vvd rec stop" >&2
         exit 1 ;;
    esac
    ;;
  shot)
    dest="${2:-$PWD/out/vvd-$(date +%H%M%S).png}"
    dir="$(dirname "$dest")"
    mkdir -p "$dir"
    # The console writes into a directory and names the file itself, so the
    # newest png in there afterwards is ours.
    before="$(ls -t "$dir"/*.png 2>/dev/null | head -1 || true)"
    console "screenrecord screenshot $dir" >/dev/null
    after="$(ls -t "$dir"/*.png 2>/dev/null | head -1 || true)"
    [ -n "$after" ] && [ "$after" != "$before" ] || {
      echo "no screenshot produced" >&2; exit 1; }
    [ "$after" = "$dest" ] || mv "$after" "$dest"
    echo "$dest"
    ;;
  console) console "${2:?command}" ;;
  *) sed -n '/^# Usage:/,/^set -e/p' "$0" | sed 's/^# \{0,1\}//;$d' ;;
esac
